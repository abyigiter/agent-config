# Hermes Agent Environment Configuration
# Copy this to .env and fill in your API keys.
# cp hermes/.env.template ~/.hermes/.env && chmod 600 ~/.hermes/.env && $EDITOR ~/.hermes/.env

# ── LLM PROVIDER (OpenRouter) ─────────────────────────────────────────
# All LLM calls go through OpenRouter — no direct provider keys needed.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ── TOOL API KEYS (optional — needed for web search, images, etc.) ───
# Exa — AI-native web search. Get at: https://exa.ai
EXA_API_KEY=
# Firecrawl — web search, extract, and crawl. Get at: https://firecrawl.dev/
FIRECRAWL_API_KEY=
# Browserbase — cloud browser execution. Get at: https://browserbase.com/
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# FAL — image generation. Get at: https://fal.ai/
FAL_KEY=
# GitHub token — for higher API rate limits on skill search/install
GITHUB_TOKEN=

# ── VOICE / STT (optional) ───────────────────────────────────────────
# For voice transcription via OpenAI Whisper:
VOICE_TOOLS_OPENAI_KEY=
# For local STT, install faster-whisper and no key is needed.

# ── MESSAGING INTEGRATIONS (optional) ────────────────────────────────
# Slack:
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Telegram (from @BotFather):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=

# ── TERMINAL (optional overrides) ────────────────────────────────────
TERMINAL_TIMEOUT=60